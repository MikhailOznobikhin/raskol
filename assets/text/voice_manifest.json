{
  "version": 1,
  "note": "Генерится src/voice/collect_voice_manifest.py; id стабильные, не перенумеровывать — на них завязан кэш озвучки.",
  "speakers": {
    "Торвин": {
      "sex": "male",
      "note": "низкий мужской, гном, живой"
    },
    "Селена Вейн": {
      "sex": "female",
      "note": "женский, усталая горечь"
    },
    "Гхарн": {
      "sex": "male",
      "note": "рычащий низкий босс"
    },
    "Стражник": {
      "sex": "male",
      "note": "армейские реплики, мрачный"
    },
    "Рассказчик": {
      "sex": "male",
      "note": "за кадром, записки/предметы/барки"
    }
  },
  "lines": [
    {
      "speaker": "Торвин",
      "text": "Тёплое. Солёное. Оно шевелится во мне — и магия снова течёт.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_001",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Двадцать единиц — и оковы поддадутся.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_002",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Свобода. Пахнет сыростью и железом.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_003",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "В коридоре темно. Пригнусь — Ctrl. Тихо — Shift не жму. Камень (G) отвлечёт стражу.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_004",
      "priority": 1
    },
    {
      "speaker": "Селена Вейн",
      "text": "Гном. Живой. Значит, это правда — вы едите нас и получаете силу.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_005",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Я не ел... Я выживал. Это разные вещи. Иногда.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_006",
      "priority": 1
    },
    {
      "speaker": "Селена Вейн",
      "text": "Мой брат Орлан погиб в горах семь лет назад. Скажи, что ты не...",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_007",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Я знал его.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_008",
      "priority": 1
    },
    {
      "speaker": "Селена Вейн",
      "text": "Тогда слушай: есть ритуал, который выжигает магию из крови. Любую.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_009",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Прости. Во мне слишком много голода.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_010",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Есть выборы, которых я не могу себе позволить.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_011",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Всё. Хватит. Я больше не буду тем, кем меня сделали.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_012",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Шахта. Воздух. Снег. Свобода пахнет холодом.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_013",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Я вышел из земли. Над горами — кровавая луна, и снег в её свете кажется пеплом.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_014",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Первый шаг сделан. Теперь — война.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_015",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Просыпайся, гном. Шахта «Кровавый Клык», год седьмой после Раскола.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_016",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Кандалы, пустая камера и запах гнилой плоти. Значит, я ещё жив.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_017",
      "priority": 1
    },
    {
      "speaker": "Торвин",
      "text": "Снова этот камень. Снова этот воздух. Идём дальше.",
      "source": "mission3d.gd",
      "kind": "dlg",
      "id": "m1_dlg_018",
      "priority": 1
    },
    {
      "speaker": "Стражник",
      "text": "Эй, кто там?",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_001",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Слышу шаги...",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_002",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Огонь гаснет...",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_003",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Не подходи.",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_004",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Кто-то идёт.",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_005",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Тихо там.",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_006",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Берегись!",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_007",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Свет гаснет...",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_008",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Звук шагов...",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_009",
      "priority": 3
    },
    {
      "speaker": "Стражник",
      "text": "Кто здесь?",
      "source": "lore.json#barks",
      "kind": "bark",
      "id": "m1_bark_010",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "Стражи боятся света. Держись факелов.",
      "source": "lore.json#notes",
      "kind": "note",
      "id": "m1_note_001",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "Босс в глубине. Не подходи без оружия.",
      "source": "lore.json#notes",
      "kind": "note",
      "id": "m1_note_002",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "Кровь даёт силу, но отнимает разум.",
      "source": "lore.json#notes",
      "kind": "note",
      "id": "m1_note_003",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "Селена знает путь. Поговори с ней.",
      "source": "lore.json#notes",
      "kind": "note",
      "id": "m1_note_004",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+10 к урону.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_001",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+5 к защите.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_002",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+15 магии.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_003",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+25 HP.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_004",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+1 к скорости.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_005",
      "priority": 3
    },
    {
      "speaker": "Рассказчик",
      "text": "+10% к уклонению.",
      "source": "lore.json#items",
      "kind": "item",
      "id": "m1_item_006",
      "priority": 3
    }
  ]
}
